{
	"name": "@deepseek/ds-agent",
	"version": "0.1.0",
	"description": "DeepSeek Terminal Agent - AI coding assistant powered by DeepSeek V4",
	"type": "module",
	"bin": { "dsc": "dist/cli.js" },
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest --run"
	},
	"dependencies": {
		"@deepseek/ds-core": "^0.1.0",
		"@mariozechner/pi-ai": "^0.73.0",
		"@mariozechner/pi-agent-core": "^0.73.0",
		"@mariozechner/pi-coding-agent": "^0.73.0",
		"@mariozechner/pi-tui": "^0.73.0",
		"chalk": "^5.5.0",
		"undici": "^7.19.1"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"engines": { "node": ">=20.0.0" },
	"license": "MIT"
}
