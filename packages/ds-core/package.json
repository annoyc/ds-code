		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"typebox": "^1.1.24"
	},
	"devDependencies": {
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20.0.0"
	},
