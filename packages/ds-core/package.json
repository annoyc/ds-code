{
	"name": "@deepseek/ds-core",
	"version": "0.1.0",
	"description": "DeepSeek-focused pricing, cost tracking, and routing helpers",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist"],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
